# Copie para .env e substitua as credenciais de exemplo antes de iniciar.
# A mesma credencial protege backoffice, API e dashboard.
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=replace-with-a-long-random-password

# Para um banco novo, gere senhas fortes; preserve as credenciais existentes ao reutilizar um volume.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
DB_NAME=controle_reforma
DB_USER=reforma
DB_PASS=replace-with-a-unique-database-password

# Opcional; mantém as portas acessíveis somente neste computador.
HOST_BIND_ADDRESS=127.0.0.1
